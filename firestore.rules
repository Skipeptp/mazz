rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields:
    //   - displayName: string
    //   - email: string
    //   - photoURL: string
    //   - role: string (user/admin)
    //
    // Collection: messages
    // Fields:
    //   - text: string (max 1000 chars)
    //   - senderId: string (UID)
    //   - senderName: string
    //   - timestamp: timestamp
    //
    // Collection: notes
    // Fields:
    //   - title: string (optional)
    //   - content: string (max 5000 chars)
    //   - authorId: string (UID)
    //   - authorName: string
    //   - timestamp: timestamp
    //   - color: string (optional)
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getEmail() {
      let tokenEmail = request.auth.token.get('email', '');
      let identityEmail = request.auth.token.get('firebase', {}).get('identities', {}).get('email', [''])[0];
      let email = tokenEmail != '' ? tokenEmail : identityEmail;
      return email.toLowerCase();
    }

    function isOwner(userId) {
      let email = getEmail();
      return isAuthenticated() && (request.auth.uid == userId || email == userId.toLowerCase());
    }

    function isAdmin() {
      let email = getEmail();
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
         email == "glebkarpuhin8@gmail.com" ||
         request.auth.uid == "icJVZJAGunVRp81EFYPsEOzLvrP2");
    }

    function isWhitelisted() {
      let email = getEmail();
      let tokenEmail = request.auth.token.get('email', '').toLowerCase();
      return isAuthenticated() && 
             (email == "glebkarpuhin8@gmail.com" || 
              email == "arhipovaaliena78@gmail.com" ||
              tokenEmail == "glebkarpuhin8@gmail.com" ||
              tokenEmail == "arhipovaaliena78@gmail.com" ||
              request.auth.uid == "icJVZJAGunVRp81EFYPsEOzLvrP2");
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['text', 'senderId', 'senderName', 'timestamp']) &&
             data.text is string && data.text.size() <= 1000 &&
             data.senderId == request.auth.uid &&
             data.timestamp is timestamp;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['content', 'authorId', 'authorName', 'timestamp']) &&
             data.content is string && data.content.size() <= 5000 &&
             data.authorId is string &&
             data.timestamp is timestamp &&
             (!('title' in data) || (data.title is string && data.title.size() <= 100)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 20)) &&
             (!('type' in data) || (data.type in ['text', 'list'])) &&
             (!('items' in data) || (data.items is list));
    }

    function isValidNoteUpdate(data, oldData) {
      // Allow updating items (checklist) by anyone whitelisted
      // But only the author can update content/title/color
      let isAuthor = request.auth.uid == oldData.authorId;
      let onlyItemsChanged = data.diff(oldData).affectedKeys().hasOnly(['items']);
      
      return isValidNote(data) && (isAuthor || onlyItemsChanged);
    }

    function isValidUser(data) {
      let email = data.get('email', '').toLowerCase();
      return email == "glebkarpuhin8@gmail.com" || email == "arhipovaaliena78@gmail.com";
    }

    function emailUnchanged() {
      return request.resource.data.email == resource.data.email;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read, list: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /messages/{messageId} {
      allow read, list: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /notes/{noteId} {
      allow read, list: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
