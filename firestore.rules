rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields:
    //   - displayName: string
    //   - email: string
    //   - photoURL: string
    //   - role: string (user/admin)
    //
    // Collection: messages
    // Fields:
    //   - text: string (max 1000 chars)
    //   - senderId: string (UID)
    //   - senderName: string
    //   - timestamp: timestamp
    //
    // Collection: notes
    // Fields:
    //   - title: string (optional)
    //   - content: string (max 5000 chars)
    //   - authorId: string (UID)
    //   - authorName: string
    //   - timestamp: timestamp
    //   - color: string (optional)
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isWhitelisted() {
      let email = request.auth.token.email;
      let identities = request.auth.token.firebase.identities;
      return isAuthenticated() && 
             (
               (email != null && (email.toLowerCase() == "glebkarpuhin8@gmail.com" || email.toLowerCase() == "arhipovaaliena78@gmail.com")) ||
               ('email' in identities && (identities.email[0].toLowerCase() == "glebkarpuhin8@gmail.com" || identities.email[0].toLowerCase() == "arhipovaaliena78@gmail.com"))
             );
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['text', 'senderId', 'senderName', 'timestamp']) &&
             data.text is string && data.text.size() <= 1000 &&
             data.senderId == request.auth.uid &&
             data.timestamp is timestamp;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['content', 'authorId', 'authorName', 'timestamp']) &&
             data.content is string && data.content.size() <= 5000 &&
             data.authorId is string &&
             data.timestamp is timestamp &&
             (!('title' in data) || (data.title is string && data.title.size() <= 100)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 20)) &&
             (!('type' in data) || (data.type in ['text', 'list'])) &&
             (!('items' in data) || (data.items is list));
    }

    function isValidNoteUpdate(data, oldData) {
      // Allow updating items (checklist) by anyone whitelisted
      // But only the author can update content/title/color
      let isAuthor = request.auth.uid == oldData.authorId;
      let onlyItemsChanged = data.diff(oldData).affectedKeys().hasOnly(['items']);
      
      return isValidNote(data) && (isAuthor || onlyItemsChanged);
    }

    function isValidUser(data) {
      return data.email is string &&
             (data.email.toLowerCase() == "glebkarpuhin8@gmail.com" || data.email.toLowerCase() == "arhipovaaliena78@gmail.com") &&
             data.displayName is string;
    }

    function emailUnchanged() {
      return request.resource.data.email == resource.data.email;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isWhitelisted() && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId);
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isWhitelisted() && isValidMessage(request.resource.data);
      allow delete: if isWhitelisted();
    }

    match /notes/{noteId} {
      allow read: if isAuthenticated();
      allow create: if isWhitelisted() && isValidNote(request.resource.data) && request.resource.data.authorId == request.auth.uid;
      allow update: if isWhitelisted() && isValidNoteUpdate(request.resource.data, resource.data);
      allow delete: if isWhitelisted();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
