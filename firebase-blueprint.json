{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "A chat message between the couple",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "The message content" },
        "senderId": { "type": "string", "description": "UID of the sender" },
        "senderName": { "type": "string", "description": "Name of the sender" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the message was sent" }
      },
      "required": ["text", "senderId", "timestamp"]
    },
    "Note": {
      "title": "Note",
      "description": "A shared note or memory",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the note" },
        "content": { "type": "string", "description": "Content of the note (markdown supported)" },
        "authorId": { "type": "string", "description": "UID of the creator" },
        "authorName": { "type": "string", "description": "Name of the creator" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the note was last updated" },
        "color": { "type": "string", "description": "Background color for the note card" }
      },
      "required": ["content", "authorId", "timestamp"]
    },
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "messages": {
      "schema": "Message",
      "description": "Collection of chat messages"
    },
    "notes": {
      "schema": "Note",
      "description": "Collection of shared notes"
    },
    "users": {
      "schema": "User",
      "description": "Collection of user profiles"
    }
  }
}
