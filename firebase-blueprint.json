{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information including mood, status and tier list.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "mood": { "type": "string", "description": "Current mood emoji" },
        "status": { "type": "string", "description": "Current status or wish" },
        "location": { "type": "string", "description": "Current location" },
        "tierList": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "tier": { "type": "string", "enum": ["S", "A", "B", "C", "D"] }
            }
          }
        }
      },
      "required": ["email", "displayName", "photoURL", "role"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message between users.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "timestamp": { "type": "object", "description": "Firestore server timestamp" }
      },
      "required": ["text", "senderId", "senderName", "timestamp"]
    },
    "Note": {
      "title": "Note",
      "description": "A shared note or memory.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "timestamp": { "type": "object", "description": "Firestore server timestamp" },
        "color": { "type": "string" }
      },
      "required": ["content", "authorId", "authorName", "timestamp"]
    },
    "DailyHoroscope": {
      "title": "DailyHoroscope",
      "description": "Cached daily horoscope data for the couple.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "YYYY-MM-DD format" },
        "virgo": { "type": "object" },
        "aries": { "type": "object" },
        "couple": { "type": "object" },
        "question": { "type": "string" }
      },
      "required": ["date", "virgo", "aries", "couple", "question"]
    },
    "PetState": {
      "title": "PetState",
      "description": "Current state of the virtual pet Frosh.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "hunger": { "type": "number", "description": "0-100" },
        "energy": { "type": "number", "description": "0-100" },
        "isSleeping": { "type": "boolean" },
        "lastFed": { "type": "object" },
        "lastSlept": { "type": "object" },
        "lastWokeUp": { "type": "object" },
        "isGone": { "type": "boolean" },
        "foodAvailable": { "type": "number" },
        "cooldownUntil": { "type": "object" }
      },
      "required": ["name", "hunger", "energy", "isSleeping", "isGone", "foodAvailable"]
    },
    "QuizQuestion": {
      "title": "QuizQuestion",
      "description": "A question asked by one user to another to earn food.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "answer": { "type": "string" },
        "fromId": { "type": "string" },
        "toId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "correct", "incorrect"] },
        "timestamp": { "type": "object" }
      },
      "required": ["text", "answer", "fromId", "toId", "status", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages collection"
    },
    "notes/{noteId}": {
      "schema": "Note",
      "description": "Shared notes collection"
    },
    "horoscopes/{date}": {
      "schema": "DailyHoroscope",
      "description": "Daily cached horoscopes"
    },
    "pet/frosh": {
      "schema": "PetState",
      "description": "Singleton state for the pet"
    },
    "quizzes/{quizId}": {
      "schema": "QuizQuestion",
      "description": "Quiz questions for food"
    }
  }
}
